# Native Oracle MySQL 8.0.16+ on the local device.
# Create the database and local application user in your native MySQL installation.
# Generate a password with: openssl rand -hex 24
# Keep this URL on loopback for local scripts; never commit the actual .env file.
DATABASE_URL=mysql://dag_local:REPLACE_WITH_A_UNIQUE_48_CHARACTER_HEX_SECRET@127.0.0.1:3306/desert_art_gallery

# Leave empty for local development: application media defaults to .local-data/media.
MEDIA_STORAGE_ROOT=

# Enable the MySQL catalogue and local owner workspace only after migrations and owner bootstrap.
MYSQL_CATALOGUE_ENABLED=false
# Enable MySQL customer sessions only after migration and local owner/catalogue acceptance.
MYSQL_CUSTOMER_AUTH_ENABLED=false
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# One-time local owner bootstrap. Remove LOCAL_ADMIN_PASSWORD after the first successful run.
LOCAL_ADMIN_EMAIL=
LOCAL_ADMIN_PASSWORD=
LOCAL_ADMIN_NAME=Gallery Owner

# Legacy customer/account routes still use these until their MySQL migration is complete.
# Keep blank for MySQL-only work; legacy customer features remain unavailable until migrated.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Needed only for the one-time legacy editorial source importer.
SUPABASE_SERVICE_ROLE_KEY=
