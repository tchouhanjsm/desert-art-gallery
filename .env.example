# Legacy Supabase authentication and commerce backend (kept during staged migration).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# New self-hosted MySQL editorial backend. Leave unset to keep using the legacy CMS backend.
# For Hostinger shared/managed Node apps, use 127.0.0.1 when that is the hostname shown in hPanel.
# URL-encode special characters in username/password.
DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/DATABASE_NAME

# Absolute, persistent filesystem directory for owner-uploaded editorial media.
# Local development can omit this and writes to .local-data/media.
# Production requires an explicit persistent path.
MEDIA_STORAGE_ROOT=

# Canonical public URL.
NEXT_PUBLIC_SITE_URL=https://desertartgallery.net

# Payment providers: configure only after merchant account approval.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Transactional email provider.
RESEND_API_KEY=
ORDER_EMAIL_FROM=

# Analytics. Enable only with consent management in place.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
