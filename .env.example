# Existing authentication and commerce fallback. Keep configured during staged migration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Self-hosted MySQL, server-side only.
DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/DATABASE_NAME
MEDIA_STORAGE_ROOT=

# Catalogue MySQL adapter remains disabled until local acceptance.
MYSQL_CATALOGUE_ENABLED=false

NEXT_PUBLIC_SITE_URL=https://desertartgallery.net
