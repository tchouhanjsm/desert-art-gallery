# Public Supabase project configuration. These values are safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase service role. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical production URL.
NEXT_PUBLIC_SITE_URL=https://desertartgallery.net

# Payment providers: configure only after merchant account approval.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Transactional email provider.
RESEND_API_KEY=
ORDER_EMAIL_FROM=

# Analytics. Enable only with consent management in place.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
