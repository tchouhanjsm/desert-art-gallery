# Local MySQL. Hostinger later uses this same schema; only DATABASE_URL changes.
# Run docker compose up -d to start the local database.
DATABASE_URL=mysql://root:localdevpassword@127.0.0.1:3306/desert_art_gallery

# Local uploads are kept in an ignored directory. Set an absolute persistent path in production.
MEDIA_STORAGE_ROOT=

# Canonical public URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Initial owner bootstrap. Set only for the one-time npm run db:create-owner command,
# then remove OWNER_PASSWORD from this file.
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=

# Optional transactional email for password recovery. The app works locally without it;
# without email delivery, reset tokens are written only to the server log in development.
RESEND_API_KEY=
ORDER_EMAIL_FROM=

# Payment providers are not activated until merchant approval and webhook tests are complete.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Analytics. Enable only after consent management is implemented.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
