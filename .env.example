# Local project-contained MySQL (Docker Compose reads these values from this file).
# Generate two different secrets with: openssl rand -hex 24
MYSQL_ROOT_PASSWORD=REPLACE_WITH_A_UNIQUE_48_CHARACTER_HEX_SECRET
MYSQL_DATABASE=desert_art_gallery
MYSQL_USER=dag_local
MYSQL_PASSWORD=REPLACE_WITH_ANOTHER_UNIQUE_48_CHARACTER_HEX_SECRET
MYSQL_HOST_PORT=3306

# Keep the password here in sync with MYSQL_PASSWORD above. Hex secrets need no URL encoding.
DATABASE_URL=mysql://dag_local:REPLACE_WITH_ANOTHER_UNIQUE_48_CHARACTER_HEX_SECRET@127.0.0.1:3306/desert_art_gallery

# Leave empty for local development: media defaults to .local-data/media inside this repository.
MEDIA_STORAGE_ROOT=

# Enable MySQL catalogue and owner workspace only after migrations and owner bootstrap.
MYSQL_CATALOGUE_ENABLED=false
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# One-time local owner bootstrap. Remove LOCAL_ADMIN_PASSWORD after the first successful run.
LOCAL_ADMIN_EMAIL=
LOCAL_ADMIN_PASSWORD=
LOCAL_ADMIN_NAME=Gallery Owner

# Legacy customer/account routes still use these until their MySQL migration is complete.
# Leave blank for MySQL-only local work; legacy customer features remain unavailable until migrated.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Needed only for the one-time legacy editorial source importer.
SUPABASE_SERVICE_ROLE_KEY=
