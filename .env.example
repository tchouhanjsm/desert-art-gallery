# Self-hosted MySQL application database (server-side only).
DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/DATABASE_NAME
MEDIA_STORAGE_ROOT=

# Enable the staged MySQL catalogue and local owner workspace only after migration.
MYSQL_CATALOGUE_ENABLED=false

# Local development origin. Set the verified official HTTPS origin in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# One-time local owner bootstrap. Use a unique password of at least 12 characters.
# Run npm run db:bootstrap-admin once, then remove LOCAL_ADMIN_PASSWORD from the environment.
LOCAL_ADMIN_EMAIL=
LOCAL_ADMIN_PASSWORD=
LOCAL_ADMIN_NAME=Gallery Owner

# Legacy routes only: customer accounts/cart/orders remain outside this MySQL phase.
# Leave blank for the self-hosted MySQL owner/catalogue workspace.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Needed only if you run the one-time editorial source importer.
SUPABASE_SERVICE_ROLE_KEY=
