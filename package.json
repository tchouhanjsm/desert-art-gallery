{
  "name": "desert-art-gallery",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run src/server/db/mysql.integration.test.ts",
    "local:prepare": "node --import=tsx scripts/prepare-local-workspace.ts",
    "db:ping": "node --import=tsx scripts/mysql-status.ts --ping",
    "db:status": "node --import=tsx scripts/mysql-status.ts",
    "db:migrate": "node --import=tsx scripts/migrate-mysql.ts",
    "db:studio": "drizzle-kit studio --config=drizzle.config.ts",
    "db:import-editorial": "node --env-file=.env --import=tsx scripts/import-editorial-to-mysql.ts",
    "db:bootstrap-admin": "node --env-file=.env --import=tsx scripts/bootstrap-local-admin.ts",
    "db:bootstrap-staging-admin": "node --env-file=.env --import=tsx scripts/bootstrap-staging-admin.ts",
    "db:import-products": "node --env-file=.env --import=tsx scripts/import-products-to-mysql.ts",
    "media:preview": "node --import=tsx scripts/preview-product-images.ts",
    "media:import": "node --env-file=.env --import=tsx scripts/import-product-images-to-mysql.ts",
    "media:download-etsy": "node --env-file=.env --import=tsx scripts/download-etsy-images.ts",
    "media:map-recovered": "node --env-file=.env --import=tsx scripts/preview-recovered-product-mapping.ts",
    "media:audit-recovered": "node --env-file=.env --import=tsx scripts/audit-recovered-product-photos.ts",
    "db:catalogue-preflight": "node --env-file=.env --import=tsx scripts/catalogue-preflight.ts",
    "media:stage-recovered": "node --env-file=.env --import=tsx scripts/stage-recovered-product-photos.ts",
    "visual:review": "node --import=tsx scripts/capture-storefront-review.ts"
  },
  "dependencies": {
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "lucide-react": "^0.468.0",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.1",
    "drizzle-orm": "0.45.4",
    "mysql2": "3.24.6",
    "@fontsource-variable/playfair-display": "^5.0.0",
    "@fontsource-variable/inter": "^5.0.0",
    "@aws-sdk/client-s3": "3.1161.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.3",
    "drizzle-kit": "0.31.11",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.1.6",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "tsx": "4.20.6",
    "playwright": "1.56.1"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
