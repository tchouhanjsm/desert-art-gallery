{
  "name": "desert-art-gallery",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run src/server/db/mysql.integration.test.ts",
    "db:up": "docker compose up -d mysql",
    "db:stop": "docker compose stop mysql",
    "db:status": "docker compose ps mysql",
    "db:logs": "docker compose logs --tail=100 mysql",
    "db:migrate": "node --import=tsx scripts/migrate-mysql.ts",
    "db:studio": "drizzle-kit studio --config=drizzle.config.ts",
    "db:import-editorial": "node --env-file=.env --import=tsx scripts/import-editorial-to-mysql.ts",
    "db:bootstrap-admin": "node --env-file=.env --import=tsx scripts/bootstrap-local-admin.ts",
    "db:import-products": "node --env-file=.env --import=tsx scripts/import-products-to-mysql.ts"
  },
  "dependencies": {
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "lucide-react": "^0.468.0",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.1",
    "drizzle-orm": "0.45.4",
    "mysql2": "3.24.6",
    "@fontsource-variable/cormorant-garamond": "5.3.0",
    "@fontsource-variable/dm-sans": "5.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.3",
    "drizzle-kit": "0.31.11",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.1.6",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "tsx": "4.20.6"
  }
}
